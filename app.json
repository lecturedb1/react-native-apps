{
  "expo": {
    "name": "react-native-apps",
    "slug": "react-native-apps",
    "scheme": "react-native-apps",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.lecturedbsteam.reactnativeapps",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "package": "com.lecturedbsteam.reactnativeapps"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "주변 마트를 찾기 위해 현재 위치를 사용합니다."
        }
      ],
      "expo-notifications",
      [
        "expo-widgets",
        {
          "enableAndroid": true,
          "widgets": [
            {
              "name": "FavoritesWidget",
              "displayName": "즐겨찾기",
              "description": "즐겨찾기 개수를 표시합니다.",
              "ios": {
                "supportedFamilies": ["systemSmall"]
              },
              "android": {
                "targetCellWidth": 2,
                "targetCellHeight": 2
              }
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "6008e0eb-c295-4081-9f5d-577ee44e9c4f"
      }
    },
    "owner": "lecturedbs-team"
  }
}
